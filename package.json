{
  "name": "ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI Gateway: one OpenAI-compatible API in front of every model provider, with routing, fallback, budgets, caching and full request-level observability.",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @ai-gateway/gateway build && pnpm --filter @ai-gateway/worker build && pnpm --filter @ai-gateway/cli build && pnpm --filter @ai-gateway/mcp build",
    "build:dashboard": "pnpm --filter @ai-gateway/dashboard build",
    "build:all": "pnpm build && pnpm build:dashboard",
    "clean": "pnpm -r exec rm -rf dist .next tsconfig.tsbuildinfo",
    "dev": "pnpm --filter @ai-gateway/gateway dev",
    "dev:dashboard": "pnpm --filter @ai-gateway/dashboard dev",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "node --import tsx benchmarks/gateway-overhead.bench.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
