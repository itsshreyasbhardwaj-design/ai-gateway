# ─────────────────────────────────────────────────────────────────────────────
# AI Gateway configuration
#
# Everything here is optional for local development: with an empty file the
# gateway boots with an in-memory store, in-process counters and the synthetic
# mock provider, and tells you so. Nothing below is required until you want
# real providers or a durable deployment.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Gateway service ──────────────────────────────────────────────────────────
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
GATEWAY_URL=http://localhost:8787
LOG_LEVEL=info
# Human-readable logs instead of JSON. Leave off in production.
LOG_PRETTY=true
# Only enable behind a proxy you control: X-Forwarded-For is spoofable otherwise.
TRUST_PROXY=false
# Comma-separated browser origins allowed to call the gateway directly.
CORS_ORIGINS=http://localhost:3000

# ── Storage ──────────────────────────────────────────────────────────────────
# Omit for the in-memory store. REQUIRED in production: the in-memory store
# loses every request, key and policy on restart.
# DATABASE_URL=postgresql://aigw:aigw@localhost:5432/aigw

# Omit for in-process counters, which are correct for a single replica only.
# With more than one gateway replica, rate limits and spend counters need Redis
# to agree with each other.
# REDIS_URL=redis://localhost:6379

# ── Secrets ──────────────────────────────────────────────────────────────────
# Encrypts provider credentials and webhook secrets at rest.
# REQUIRED in production. Generate with: openssl rand -base64 32
# In development a throwaway key is generated per process and you are warned
# that stored secrets will not survive a restart.
ENCRYPTION_KEY=

# Pepper for the API-key lookup index, so a database dump cannot be used to
# precompute key lookups. REQUIRED in production. Rotating it invalidates every
# existing key. Generate with: openssl rand -base64 32
API_KEY_PEPPER=

# ── Provider credentials ─────────────────────────────────────────────────────
# Set whichever you have. The gateway registers exactly the providers whose
# credentials are present, and says at boot which ones came up.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# OPENROUTER_API_KEY=

# Self-hosted / OpenAI-compatible runtime (vLLM, Ollama, LM Studio, TGI).
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL_API_KEY=

# ── Behaviour ────────────────────────────────────────────────────────────────
# The synthetic mock provider. On by default outside production so a fresh
# clone has something to route to. Its output is always clearly labelled and it
# is never registered under a real vendor's id.
ENABLE_MOCK_PROVIDER=true

# Hosts permitted as custom provider or webhook URLs despite resolving to a
# private address. Deny-by-default otherwise; cloud metadata endpoints are
# always refused. Supports wildcards: *.svc.cluster.local
# PROVIDER_ALLOWED_HOSTS=ollama.internal,127.0.0.1

# Model used to embed prompts for the semantic cache. Must support embeddings
# and be registered; otherwise semantic caching stays off and says why.
# SEMANTIC_CACHE_EMBEDDING_MODEL=openai/text-embedding-3-small

DEFAULT_REQUEST_TIMEOUT_MS=120000
MAX_REQUEST_BYTES=10485760

# Seed a clearly-labelled demo organization with test-flagged request history.
SEED_DEMO_DATA=false
# Fixed bootstrap key for docs and local testing. Ignored in production.
# DEMO_API_KEY=aigw_test_localdevelopmentkey000000

# ── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Skips the /connect screen by giving the dashboard a gateway key directly.
# AI_GATEWAY_ADMIN_KEY=

# Clerk gates who may open the dashboard. The dashboard always reaches the
# gateway with an API key regardless, because the gateway has no browser
# session concept and should not grow one.
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── SDK / CLI ────────────────────────────────────────────────────────────────
# AI_GATEWAY_API_KEY=
