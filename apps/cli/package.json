{
  "name": "@ai-gateway/cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "aigw - command line interface for AI Gateway",
  "type": "module",
  "bin": {
    "aigw": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/bin.js",
    "dev": "node --import tsx src/bin.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-gateway/core": "workspace:*",
    "@ai-gateway/policies": "workspace:*",
    "@ai-gateway/sdk": "workspace:*"
  }
}
